[mysqld]
# 低配 VPS (1GB 内存) 专用配置，MariaDB 10.11 兼容
# Compose's API runs in another container: 127.0.0.1 here would make the
# database unreachable to it, so bind to all interfaces (loopback-only port
# mapping in docker-compose.yaml keeps it off the public network).
bind-address=0.0.0.0

character-set-server=utf8mb4
collation-server=utf8mb4_general_ci

# Note: lower_case_table_names can ONLY be set at data-dir init time.
# Setting it after MySQL has started will crash the service.
# Existing data must be migrated explicitly; never delete it to repair config.
# lower_case_table_names=1

skip-name-resolve
skip-host-cache

# ===== 低配 VPS 性能参数 (1GB 内存，MariaDB 10.11 兼容) =====
# loose- 前缀保证跨版本兼容：不支持的参数用默认值，不影响启动

# InnoDB 缓冲池：1GB 内存机器给 64M
innodb_buffer_pool_size=64M
innodb_log_buffer_size=4M

# 事务提交时的日志刷新策略 (2=每次提交写入但每秒刷新，平衡性能与安全)
innodb_flush_log_at_trx_commit=2
innodb_io_capacity=200
innodb_io_capacity_max=400
innodb_read_io_threads=2
innodb_write_io_threads=2
innodb_file_per_table=1

# 连接数：低配机器不要 500
max_connections=80
thread_cache_size=8
table_open_cache=200
table_definition_cache=200

# 每连接缓冲区，调小避免内存暴涨
sort_buffer_size=512K
join_buffer_size=512K
read_buffer_size=256K
read_rnd_buffer_size=256K

max_allowed_packet=32M
tmp_table_size=16M
max_heap_table_size=16M

wait_timeout=300
interactive_timeout=300

# 关闭性能_schema 节省约 100MB 内存
performance_schema=OFF

# binlog 保留 3 天，避免撑爆磁盘
loose-expire_logs_days=3
loose-binlog_expire_logs_seconds=259200
max_binlog_size=128M

[client]
default-character-set=utf8mb4

[mysql]
default-character-set=utf8mb4
