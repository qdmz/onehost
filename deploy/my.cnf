[mysqld]
# 低配 VPS (1GB 内存) 专用配置，MariaDB 10.11 兼容
# 注意：不能设置 bind-address=127.0.0.1，否则 api 容器无法通过 mysql:3306 连接

character-set-server=utf8mb4
collation-server=utf8mb4_general_ci

skip-name-resolve
skip-host-cache

# InnoDB 缓冲池：1GB 内存机器给 64M
innodb_buffer_pool_size=64M
innodb_log_buffer_size=4M
innodb_flush_log_at_trx_commit=2
innodb_io_capacity=200
innodb_io_capacity_max=400
innodb_read_io_threads=2
innodb_write_io_threads=2
innodb_file_per_table=1

# 连接数：低配机器不要 500
max_connections=80
thread_cache_size=8
table_open_cache=200
table_definition_cache=200

# 每连接缓冲区，调小避免内存暴涨
sort_buffer_size=512K
join_buffer_size=512K
read_buffer_size=256K
read_rnd_buffer_size=256K

max_allowed_packet=32M
tmp_table_size=16M
max_heap_table_size=16M

wait_timeout=300
interactive_timeout=300

# 关闭性能_schema 节省约 100MB 内存
performance_schema=OFF

# binlog 保留 3 天，避免撑爆磁盘
loose-expire_logs_days=3
loose-binlog_expire_logs_seconds=259200
max_binlog_size=128M

[client]
default-character-set=utf8mb4

[mysql]
default-character-set=utf8mb4
